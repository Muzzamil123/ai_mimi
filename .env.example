# ---------------------------------------------------------------------------
# Local development configuration. Copy to `.env` and adjust as needed:
#   cp .env.example .env
# Docker Compose reads this file automatically for variable substitution.
# NEVER commit a real `.env` — it is gitignored.
# ---------------------------------------------------------------------------

# --- PostgreSQL ---
DATABASE_USERNAME=aicvp
DATABASE_PASSWORD=aicvp_password
DATABASE_NAME=aicvp_development
DATABASE_NAME_TEST=aicvp_test
# Host port mappings (containers always use the internal 5432/6379).
DATABASE_PORT_HOST=5433
REDIS_PORT_HOST=6380

# --- Rails API ---
APP_VERSION=0.1.0
CORS_ORIGINS=http://localhost:5173
API_PORT_HOST=3000
# Secret used to sign JWT access tokens (set a strong random value in production).
JWT_SECRET=dev_super_secret_change_me
# Base URL of the React app, used to build links in emails.
FRONTEND_URL=http://localhost:5173
# Default "From" address for outbound email.
MAIL_FROM=AI Character Video Platform <no-reply@aicvp.local>
# Lifetime of a character email-approval link, in hours (single-use, expiring).
APPROVAL_LINK_TTL_HOURS=72
# Optional: HTTP Basic credentials protecting the Sidekiq dashboard outside development.
SIDEKIQ_WEB_USER=
SIDEKIQ_WEB_PASSWORD=
# Number of Sidekiq worker threads.
SIDEKIQ_CONCURRENCY=5

# --- Storage (character images, later video renders) ---
# Backend: `local` (filesystem). STORAGE_ROOT is where local assets are written.
STORAGE_BACKEND=local
# STORAGE_ROOT=/rails/storage

# --- Frontend (React / Vite) ---
WEB_PORT_HOST=5173
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_APP_NAME=AI Character Video Platform

# ---------------------------------------------------------------------------
# AI provider configuration.
# In development/test the adapters default to hermetic fakes, so no keys are
# required. Set the real providers + keys for production-like runs.
# ---------------------------------------------------------------------------
# Character image generation (Gemini). `fake` (default off-prod) | `gemini`.
# CHARACTER_IMAGE_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# GEMINI_IMAGE_COST_USD=0.039

# Character prompt generation (OpenAI). `local` (default off-prod) | `openai`.
# CHARACTER_PROMPT_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_PROMPT_MODEL=gpt-4o-mini

# Speech-to-text for spoken video ideas (OpenAI). `fake` (default off-prod) | `openai`.
# Reuses OPENAI_API_KEY above.
# SPEECH_TO_TEXT_PROVIDER=openai
# OPENAI_TRANSCRIBE_MODEL=whisper-1
# OPENAI_TRANSCRIBE_COST_PER_MINUTE=0.006
# OPENAI_TRANSCRIBE_TIMEOUT_SECONDS=120

# Video prompt generation (OpenAI). `local` (default off-prod) | `openai`.
# Reuses OPENAI_API_KEY + OPENAI_PROMPT_MODEL above.
# TEXT_GENERATION_PROVIDER=openai
# OPENAI_COST_PER_1K_TOKENS=0.001
# OPENAI_PROMPT_TIMEOUT_SECONDS=60

# --- Video workspace (Phase 6) ---
# Max size of an uploaded idea audio file, in bytes (default 25 MB).
# VIDEO_AUDIO_MAX_BYTES=26214400
# Enable 1–5 minute (60–300s) durations. Off = Phase 1 enforces 15s only.
# VIDEO_LONG_FORM_ENABLED=false

# Video generation (Google Labs). `fake` (default off-prod) | `google_labs`.
# Google Labs has no official public API; google_labs mode targets a configurable
# gateway / browser-automation service (see docs/operations/google-labs-automation.md).
# VIDEO_GENERATION_PROVIDER=google_labs
# GOOGLE_LABS_API_BASE_URL=https://your-google-labs-gateway.example.com
# GOOGLE_LABS_API_KEY=
# GOOGLE_LABS_MODEL=google-labs-video
# GOOGLE_LABS_COST_USD=0.50
# GOOGLE_LABS_TIMEOUT_SECONDS=60
# Shared secret for verifying inbound provider status webhooks (HMAC-SHA256).
# GOOGLE_LABS_WEBHOOK_SECRET=
# Polling bounds for in-progress generation jobs.
# VIDEO_GENERATION_MAX_POLLS=40
# VIDEO_GENERATION_POLL_INTERVAL_SECONDS=15

# --- Asset download / validation / delivery (Phase 9) ---
# Media inspection + thumbnails. `fake` (default off-prod, no ffmpeg needed) |
# `ffprobe`/`ffmpeg` (production — requires ffmpeg installed in the image).
# VIDEO_INSPECTOR=ffprobe
# VIDEO_THUMBNAILER=ffmpeg
# Lifetime of a signed asset/thumbnail/archive download URL, in seconds.
# DOWNLOAD_URL_TTL_SECONDS=3600

# Reserved for later phases:
# EMAIL_PROVIDER=letter_opener
