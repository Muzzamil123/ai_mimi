<h1>Some of your videos are ready ⚠️</h1>

<p>
  Hi <%= @user.name %> — generation for <strong><%= @video.title %></strong> in
  project <strong><%= @project.name %></strong> finished with some outputs ready
  and some failed. You can retry the failed ones from the portal.
</p>

<h2>Outputs</h2>
<ul>
  <% @outputs.each do |output| %>
    <li>
      <%= output[:label] %> — <%= output[:status] %>
      <% if output[:download_url] %>
        — <a href="<%= output[:download_url] %>">Download</a>
      <% end %>
    </li>
  <% end %>
</ul>

<p>Review, retry, and download from your portal:</p>
<p><a href="<%= @outputs_url %>"><%= @outputs_url %></a></p>
